# Copy this file to .env and fill in your values.

# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Live model used for real-time transcription
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Any SQLAlchemy URL. SQLite is used locally by default; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/speech_to_text
DATABASE_URL=sqlite:///data/transcriptions.db

# --- TURN relay for the live microphone (REQUIRED on Render / most cloud hosts) ---
# Option A (easiest): free Hugging Face access token (https://huggingface.co/settings/tokens)
HF_TOKEN=
# Option B: Cloudflare Realtime TURN key (https://dash.cloudflare.com -> Realtime -> TURN Server)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# Option C: any TURN server, e.g. Metered (comma-separated URLs allowed)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
