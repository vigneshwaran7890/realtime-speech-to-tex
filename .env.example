# Copy this file to .env and fill in your values.

# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Live model used for real-time transcription
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Any SQLAlchemy URL. SQLite is used locally by default; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/speech_to_text
DATABASE_URL=sqlite:///data/transcriptions.db
